# GuildSync central API
GUILDSYNC_ENV=staging
GUILDSYNC_ADMIN_EMAIL=admin@example.com
GUILDSYNC_ADMIN_PASSWORD=replace-with-a-long-random-password
GUILDSYNC_PUBLIC_URL=https://your-api.example.com
GUILDSYNC_BOT_API_KEY=replace-with-a-separate-random-secret-at-least-32-characters
DATABASE_URL=postgresql://user:password@host:5432/database

# Legacy API aliases remain supported during migration
CLONARDC_ENV=staging
CLONARDC_ADMIN_EMAIL=admin@example.com
CLONARDC_ADMIN_PASSWORD=replace-with-a-long-random-password
CLONARDC_PUBLIC_URL=https://your-api.example.com

# Mercado Pago — keep these values only in the hosting provider's secret manager
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_USE_SANDBOX=true
MERCADOPAGO_ALLOW_UNSIGNED_WEBHOOKS=false

# Current Mercado Pago prices are in BRL. A missing or zero price disables that plan.
CLONARDC_PRICE_1M=0
CLONARDC_PRICE_3M=0
CLONARDC_PRICE_6M=0
CLONARDC_PRICE_12M=0
CLONARDC_PRICE_PERMANENT=0

# GuildSync Discord bot
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=
GUILDSYNC_API_URL=https://clonar-dc-api.onrender.com
# Use the same GUILDSYNC_BOT_API_KEY configured on the central API.
