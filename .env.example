# GuildSync central API
GUILDSYNC_ENV=staging
GUILDSYNC_ADMIN_EMAIL=admin@example.com
GUILDSYNC_ADMIN_PASSWORD=replace-with-a-long-random-password-at-least-14-characters
GUILDSYNC_PUBLIC_URL=https://your-api.example.com
GUILDSYNC_BOT_API_KEY=replace-with-a-separate-random-secret-at-least-32-characters
GUILDSYNC_SESSION_HOURS=12
GUILDSYNC_ALLOW_FILE_STORAGE=false
# Keep false while 0.7 clients are still active. Enable only after the 0.8 mandatory-update rollout.
GUILDSYNC_REQUIRE_DEVICE_ID=false
DATABASE_URL=postgresql://user:password@host:5432/database

# Legacy API aliases remain supported only during migration
CLONARDC_ENV=staging
CLONARDC_ADMIN_EMAIL=admin@example.com
CLONARDC_ADMIN_PASSWORD=replace-with-a-long-random-password-at-least-14-characters
CLONARDC_PUBLIC_URL=https://your-api.example.com

# Mercado Pago — keep these values only in the hosting provider's secret manager
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_USE_SANDBOX=true
MERCADOPAGO_ALLOW_UNSIGNED_WEBHOOKS=false

# Prices are in BRL by default. A missing or zero price disables that plan.
GUILDSYNC_PAYMENT_CURRENCY=BRL
GUILDSYNC_PRICE_1M=0
GUILDSYNC_PRICE_3M=0
GUILDSYNC_PRICE_6M=0
GUILDSYNC_PRICE_12M=0
GUILDSYNC_PRICE_PERMANENT=0

# GuildSync Discord bot
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=
GUILDSYNC_API_URL=https://clonar-dc-api.onrender.com
GUILDSYNC_REGISTER_COMMANDS=true
# Use the same GUILDSYNC_BOT_API_KEY configured on the central API.