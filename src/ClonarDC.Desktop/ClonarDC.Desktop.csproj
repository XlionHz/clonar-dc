<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClonarDC</AssemblyName>
    <RootNamespace>ClonarDC</RootNamespace>
    <Product>GuildSync</Product>
    <Description>Visual backup, cloning and synchronization tools for Discord communities.</Description>
    <Version>0.7.0</Version>
    <FileVersion>0.7.0.0</FileVersion>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/GuildSync.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/GuildSyncLogo.png" />
    <Resource Include="Assets/GuildSync.ico" />
    <Resource Include="Assets/ClonarDCLogo.png" />
    <Resource Include="Assets/ClonarDC.ico" />
    <Content Include="api-url.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>