<Window x:Class="ClonarDC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuildSync" Icon="/ClonarDC;component/Assets/GuildSync.ico"
        Width="1380" Height="860" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen"
        Loaded="Engine08_Loaded">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0B0C14" BorderBrush="#242637" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ContentControl x:Name="SidebarBrandHost" Margin="0,0,0,22"/>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Tag="0" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="26"/><TextBlock Text="Overview"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="1" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⧉" Width="26"/><TextBlock Text="Cloning"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="2" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="26"/><TextBlock Text="Backups"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="3" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="≡" Width="26"/><TextBlock Text="Operations"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="4" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="26"/><TextBlock Text="License"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="5" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="26"/><TextBlock Text="Settings"/></StackPanel></Button>
                    <Button x:Name="AdminNav" Style="{StaticResource NavButton}" Tag="6" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◆" Width="26"/><TextBlock Text="Administration"/></StackPanel></Button>
                </StackPanel>
                <Border Grid.Row="2" Background="#12141D" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="UserNameText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UserEmailText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="VersionText" Foreground="#7C7890" FontSize="10" Margin="0,6,0,0"/>
                        <Button Content="Sign out" Margin="0,11,0,0" Padding="10,7" Click="Logout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="Pages" Grid.Column="1" Background="{StaticResource BgBrush}" BorderThickness="0" SelectionChanged="Pages_SelectionChanged">
            <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>

            <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34">
                <TextBlock Text="Overview" FontSize="30" FontWeight="Bold"/><TextBlock Text="Quick control of your GuildSync environment." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,26"/>
                <UniformGrid Columns="3" Margin="0,0,0,24">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="License" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardLicense" FontSize="21" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="Local backups" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardBackups" FontSize="21" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Last operation" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardLastOperation" Text="None in this session" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                </UniformGrid>
                <Border Background="#151225" BorderBrush="#44336F" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="Reliable workflow" FontSize="20" FontWeight="Bold"/><TextBlock Text="1. Load or enter servers  →  2. Analyze stable keys and risk  →  3. Create a preventive backup  →  4. Execute with checkpoints  →  5. Verify the destination  →  6. Resume only failed steps when needed." Foreground="#C4B5FD" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="Cloning"><Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Cloning" FontSize="30" FontWeight="Bold"/><TextBlock Text="GuildSync uses stable structure matching, resumable checkpoints and post-operation verification." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22" TextWrapping="Wrap"/></StackPanel>
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Token"/>
                            <Grid Margin="0,6,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="TokenBox" Height="42"/><Button Grid.Column="1" Content="Save" Margin="9,0,0,0" Click="AcceptTokenWithoutValidation_Click"/><Button Grid.Column="2" Content="Load servers" Margin="9,0,0,0" Click="LoadServers_Click"/></Grid>
                            <TextBlock Text="Source server ID"/>
                            <ComboBox x:Name="SourceGuildBox" Height="42" Margin="0,6,0,14" IsEditable="True" IsReadOnly="False" IsTextSearchEnabled="False" StaysOpenOnEdit="True"/>
                            <TextBlock Text="Destination server ID"/>
                            <ComboBox x:Name="TargetGuildBox" Height="42" Margin="0,6,0,0" IsEditable="True" IsReadOnly="False" IsTextSearchEnabled="False" StaysOpenOnEdit="True"/>
                            <TextBlock Text="You can select a loaded server or type its ID directly." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Mode"/><ComboBox x:Name="ModeBox" Height="42" Margin="0,6,0,14" SelectedIndex="0"><ComboBoxItem Content="Safe — only creates missing items" Tag="safe"/><ComboBoxItem Content="Merge — updates matching items and creates missing items" Tag="merge"/><ComboBoxItem Content="Exact — recreates clonable destination structure" Tag="exact"/></ComboBox>
                            <TextBlock Text="Protections"/><CheckBox x:Name="AutoBackupCheck" Content="Automatically back up the destination" IsChecked="True" Margin="0,8,0,5"/><CheckBox x:Name="RememberTokenCheck" Content="Remember the Token using Windows protection" Margin="0,2,0,18"/>
                            <WrapPanel><Button x:Name="AnalyzeEngineButton" Content="Analyze" Click="Analyze08_Click"/><Button x:Name="CloneButton" Style="{StaticResource PrimaryButton}" Content="Start" Click="Clone08_Click" IsEnabled="False"/><Button x:Name="ResumeCloneButton" Content="Resume" Click="ResumeClone08_Click" IsEnabled="False"/><Button x:Name="CancelCloneButton" Content="Cancel" Click="CancelClone08_Click" IsEnabled="False"/></WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,9,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Operation plan" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="PlanText" Text="Enter or load the servers, then run an analysis to generate the plan." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="9,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Live log" FontSize="17" FontWeight="Bold"/><ListBox x:Name="LogList" Grid.Row="1" Margin="0,10,0,0"/></Grid></Border>
                </Grid>
            </Grid></TabItem>

            <TabItem Header="Backups"><Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Backups" FontSize="30" FontWeight="Bold"/><TextBlock Text="Versioned snapshots with integrity validation and legacy 0.7 compatibility." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Refresh" Click="RefreshBackups_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Open folder" Click="OpenBackupFolder_Click"/></StackPanel></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><ListBox x:Name="BackupList" DisplayMemberPath="" SelectionChanged="BackupList_SelectionChanged"/><Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="16,0,0,0"><StackPanel><TextBlock Text="Selected backup" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="BackupDetails" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,18"/><Button Content="Verify integrity" Click="VerifyBackup_Click"/><Button x:Name="RestoreBackupButton08" Content="Restore to selected server" Click="RestoreBackup08_Click" Margin="0,9,0,0"/></StackPanel></Border></Grid>
            </Grid></TabItem>

            <TabItem Header="Operations"><Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Operations" FontSize="30" FontWeight="Bold"/><TextBlock Text="Persistent checkpoints, verification results and resumable failures." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22"/></StackPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshOperations08_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="OperationsList" SelectionChanged="OperationsList_SelectionChanged08"/>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="16,0,0,0"><StackPanel><TextBlock Text="Operation report" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="OperationDetailsText" Text="Select an operation report." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,18"/><Button x:Name="ResumeSelectedOperationButton" Style="{StaticResource PrimaryButton}" Content="Resume failed steps" Click="ResumeSelectedOperation08_Click" IsEnabled="False"/><Button x:Name="OpenOperationReportButton" Content="Open exported report" Click="OpenOperationReport08_Click" Margin="0,9,0,0" IsEnabled="False"/></StackPanel></Border>
                </Grid>
            </Grid></TabItem>

            <TabItem Header="License" Loaded="LicensePage_Loaded"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34">
                <TextBlock Text="License" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="LicenseDetails" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,24" FontSize="15" TextWrapping="Wrap"/>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" MaxWidth="720" HorizontalAlignment="Left"><StackPanel>
                    <TextBlock Text="Get or renew your GuildSync license" FontSize="20" FontWeight="Bold"/><TextBlock Text="Payment opens in Mercado Pago. The central server activates the license only after confirming the approved payment." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <TextBlock Text="Plan"/><ComboBox x:Name="PaymentPlanBox" Height="42" Margin="0,6,0,14"/><TextBlock x:Name="PaymentEnvironmentText" Foreground="#C4B5FD" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal"><Button x:Name="BuyLicenseButton" Style="{StaticResource PrimaryButton}" Content="Buy with Mercado Pago" Click="BuyLicense_Click" IsEnabled="False"/><Button Content="Refresh license" Click="RefreshLicense_Click"/></StackPanel>
                    <TextBlock x:Name="PaymentStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel></Border>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34">
                <TextBlock Text="Settings" FontSize="30" FontWeight="Bold"/>
                <UniformGrid Columns="2" Margin="0,24,0,0">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,9,0"><StackPanel>
                        <TextBlock Text="Security and storage" FontSize="18" FontWeight="Bold"/><TextBlock Text="Credentials remain on this Windows account and are never sent to the GuildSync account server." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBlock x:Name="BackupPathText" Foreground="#C4B5FD" TextWrapping="Wrap"/><Button Content="Forget saved Token" Margin="0,16,0,0" Click="ForgetToken_Click"/>
                    </StackPanel></Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="9,0,0,0"><StackPanel>
                        <TextBlock Text="Language" FontSize="18" FontWeight="Bold"/><ComboBox x:Name="LanguageBox" Margin="0,12,0,0" SelectionChanged="LanguageBox_SelectionChanged"><ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
                    </StackPanel></Border>
                </UniformGrid>
                <StackPanel x:Name="DeviceManagementHost" Margin="0,20,0,0"/>
            </StackPanel></ScrollViewer></TabItem>

            <TabItem Header="Administration"><Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Administration" FontSize="30" FontWeight="Bold"/><TextBlock Text="Manage users, licenses, account status and devices." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Publish app update" Click="PublishUpdate_Click"/><Button Content="Refresh" Click="RefreshAdmin_Click"/></StackPanel></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><ListBox x:Name="AdminUsersList" SelectionChanged="AdminUsersList_SelectionChanged"/><Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="16,0,0,0"><StackPanel><TextBlock Text="Selected user" FontSize="17" FontWeight="Bold"/><ComboBox x:Name="LicenseBox" Margin="0,14,0,12" SelectedIndex="0"><ComboBoxItem Content="1 month" Tag="1m"/><ComboBoxItem Content="3 months" Tag="3m"/><ComboBoxItem Content="1 year" Tag="1y"/><ComboBoxItem Content="Permanent" Tag="permanent"/></ComboBox><Button Style="{StaticResource PrimaryButton}" Content="Approve / set license" Click="ApproveUser_Click"/><Button Content="Suspend" Margin="0,8,0,0" Click="SuspendUser_Click"/><Button Content="Reactivate" Margin="0,8,0,0" Click="ReactivateUser_Click"/><Button Content="Revoke" Margin="0,8,0,0" Click="RevokeUser_Click"/><Button x:Name="AdminResetDevicesButton" Content="Reset devices and sessions" Margin="0,8,0,0" Click="AdminResetDevices08_Click"/></StackPanel></Border></Grid>
            </Grid></TabItem>
        </TabControl>
    </Grid>
</Window>
