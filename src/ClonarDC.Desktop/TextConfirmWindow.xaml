<Window x:Class="ClonarDC.TextConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Critical confirmation — GuildSync" Width="560" Height="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#0B0E1A">
        <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-150,-130,0" Fill="#132A2499" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
        </Ellipse>
        <Border Margin="28" Padding="30" Background="#15192A" BorderBrush="#3D4262" BorderThickness="1" CornerRadius="18">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl x:Name="ConfirmBrandHost" Width="52" Height="59" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="10,2,0,0">
                        <TextBlock Text="Confirmation required" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="GuildSync needs an explicit confirmation before this destructive operation." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="InstructionText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <TextBox x:Name="ConfirmBox" Height="44"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" Click="Cancel_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Confirm" Click="Confirm_Click"/></StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
