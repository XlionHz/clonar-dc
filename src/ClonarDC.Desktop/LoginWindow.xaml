<Window x:Class="ClonarDC.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuildSync" Icon="/ClonarDC;component/Assets/GuildSync.ico"
        Width="1280" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeroBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#080B1A" Offset="0"/>
            <GradientStop Color="#0B1030" Offset="0.48"/>
            <GradientStop Color="#080B1B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LoginBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E1B" Offset="0"/>
            <GradientStop Color="#111426" Offset="0.52"/>
            <GradientStop Color="#080B16" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171B31" Offset="0"/>
            <GradientStop Color="#111524" Offset="0.48"/>
            <GradientStop Color="#14182B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7438FF" Offset="0"/>
            <GradientStop Color="#8D38FF" Offset="0.48"/>
            <GradientStop Color="#514BFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WordmarkGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F8FAFF" Offset="0"/>
            <GradientStop Color="#F8FAFF" Offset="0.48"/>
            <GradientStop Color="#A36CFF" Offset="0.63"/>
            <GradientStop Color="#5E67FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="LoginPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <Grid>
                                <Border x:Name="ButtonGlow" Background="#00FFFFFF" CornerRadius="7"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonGlow" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#0D1120"/>
            <Setter Property="Foreground" Value="#B68AFF"/>
            <Setter Property="BorderBrush" Value="#7546D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#19152D"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A36CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="LoginIntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="HeroContentTranslate"
                             Storyboard.TargetProperty="X"
                             From="-34" To="0" Duration="0:0:0.72">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeroContent"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.62"/>

            <DoubleAnimation Storyboard.TargetName="GhostCardBackTranslate"
                             Storyboard.TargetProperty="X"
                             From="190" To="-54" BeginTime="0:0:0.06" Duration="0:0:0.78">
                <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GhostCardBack"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.24" BeginTime="0:0:0.08" Duration="0:0:0.54"/>

            <DoubleAnimation Storyboard.TargetName="GhostCardMiddleTranslate"
                             Storyboard.TargetProperty="X"
                             From="170" To="-27" BeginTime="0:0:0.11" Duration="0:0:0.76">
                <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GhostCardMiddle"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.38" BeginTime="0:0:0.13" Duration="0:0:0.54"/>

            <DoubleAnimation Storyboard.TargetName="LoginCardTranslate"
                             Storyboard.TargetProperty="X"
                             From="180" To="0" BeginTime="0:0:0.15" Duration="0:0:0.82">
                <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LoginCardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.72" To="1" BeginTime="0:0:0.15" Duration="0:0:0.82">
                <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LoginCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.14" Duration="0:0:0.58"/>

            <DoubleAnimation Storyboard.TargetName="MotionLineTranslate"
                             Storyboard.TargetProperty="X"
                             From="230" To="-30" BeginTime="0:0:0.18" Duration="0:0:0.68">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MotionLine"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.75" BeginTime="0:0:0.18" Duration="0:0:0.28" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Grid Background="#080A15" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand / hero side -->
        <Grid Grid.Column="0" Background="{StaticResource HeroBackground}" ClipToBounds="True">
            <Canvas IsHitTestVisible="False" Opacity="0.7">
                <Ellipse Width="520" Height="520" Canvas.Left="-250" Canvas.Top="-295" Fill="#101F5CFF">
                    <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="180" Height="180" Canvas.Left="320" Canvas.Top="120" Fill="#493B49FF">
                    <Ellipse.Effect><BlurEffect Radius="58"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="460" Height="340" Canvas.Left="140" Canvas.Top="585" Fill="#321B22D8">
                    <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
                </Ellipse>

                <Path Stroke="#2E3D9B" StrokeThickness="1" Opacity="0.34"
                      Data="M0,176 L80,176 L124,220 L230,220 M0,218 L48,218 L98,268 L210,268 L242,236 L330,236 M330,236 L366,200 L520,200"/>
                <Path Stroke="#4A38B7" StrokeThickness="1" Opacity="0.3"
                      Data="M0,285 L96,285 L134,323 L246,323 M285,130 L342,130 L374,98 L520,98 M374,98 L412,60 L620,60"/>
                <Path Stroke="#3249A7" StrokeThickness="1" Opacity="0.28"
                      Data="M380,312 L444,312 L482,274 L640,274 M420,355 L498,355 L538,315 L720,315"/>
                <Ellipse Width="6" Height="6" Canvas.Left="95" Canvas.Top="282" Fill="#5564FF"/>
                <Ellipse Width="5" Height="5" Canvas.Left="362" Canvas.Top="197" Fill="#744BFF"/>
                <Ellipse Width="5" Height="5" Canvas.Left="516" Canvas.Top="271" Fill="#5867FF"/>
                <Ellipse Width="4" Height="4" Canvas.Left="605" Canvas.Top="78" Fill="#7F5CFF"/>
                <Ellipse Width="3" Height="3" Canvas.Left="210" Canvas.Top="80" Fill="#4558F5"/>
                <Ellipse Width="3" Height="3" Canvas.Left="430" Canvas.Top="42" Fill="#8164FF"/>
            </Canvas>

            <Grid VerticalAlignment="Bottom" Height="168" IsHitTestVisible="False" Opacity="0.48">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#002D25AA" Offset="0"/>
                        <GradientStop Color="#190D2766" Offset="0.62"/>
                        <GradientStop Color="#09081A" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Canvas>
                    <Line X1="0" Y1="0" X2="720" Y2="0" Stroke="#754BFF" StrokeThickness="2" Opacity="0.7"/>
                    <Line X1="0" Y1="46" X2="720" Y2="46" Stroke="#3541A8" Opacity="0.34"/>
                    <Line X1="0" Y1="92" X2="720" Y2="92" Stroke="#3541A8" Opacity="0.28"/>
                    <Line X1="0" Y1="138" X2="720" Y2="138" Stroke="#3541A8" Opacity="0.22"/>
                    <Line X1="355" Y1="0" X2="30" Y2="168" Stroke="#3D43B7" Opacity="0.34"/>
                    <Line X1="355" Y1="0" X2="160" Y2="168" Stroke="#3D43B7" Opacity="0.34"/>
                    <Line X1="355" Y1="0" X2="285" Y2="168" Stroke="#3D43B7" Opacity="0.34"/>
                    <Line X1="355" Y1="0" X2="425" Y2="168" Stroke="#3D43B7" Opacity="0.34"/>
                    <Line X1="355" Y1="0" X2="550" Y2="168" Stroke="#3D43B7" Opacity="0.34"/>
                    <Line X1="355" Y1="0" X2="680" Y2="168" Stroke="#3D43B7" Opacity="0.34"/>
                </Canvas>
            </Grid>

            <StackPanel x:Name="HeroContent" Opacity="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="590" Margin="44,28,44,78">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="HeroContentTranslate" X="-34"/>
                </StackPanel.RenderTransform>

                <ContentControl x:Name="BrandMarkHost"
                                Width="186" Height="218"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Margin="0,0,0,10"/>

                <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="66" FontWeight="Bold">
                    <TextBlock.Foreground><StaticResource ResourceKey="WordmarkGradient"/></TextBlock.Foreground>
                    <Run Text="GuildSync"/>
                </TextBlock>

                <TextBlock Text="SYNC   •   CLONE   •   SCALE"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="#8074FF"
                           Margin="0,13,0,0"/>

                <TextBlock Text="Backup, clone and protect Discord communities&#x0a;with precision."
                           HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="18" Foreground="#A9ACC3"
                           Margin="0,24,0,0" TextWrapping="Wrap" LineHeight="27"/>

                <Border Background="#11152A99" BorderBrush="#37406B" BorderThickness="1"
                        CornerRadius="22" Padding="18,10" HorizontalAlignment="Center" Margin="0,31,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="14" Stretch="Uniform" Fill="#AEB4D5"
                              Data="M3,2 C6,0 12,0 15,2 C18,5 18,12 16,15 C14,17 12,14 11,13 L7,13 C6,14 4,17 2,15 C0,12 0,5 3,2 M5,7 L7,7 M6,6 L6,8 M11,7 A1,1 0 1 0 13,7 A1,1 0 1 0 11,7"/>
                        <TextBlock Text="OFFICIAL DISCORD API" Margin="9,0,16,0" FontSize="10" FontWeight="SemiBold" Foreground="#ABB0C9" VerticalAlignment="Center"/>
                        <Border Width="1" Height="18" Background="#3C4263"/>
                        <Path Width="17" Height="17" Stretch="Uniform" Stroke="#AEB4D5" StrokeThickness="1.6" Fill="Transparent" Margin="16,0,0,0"
                              Data="M2,4 C2,1 14,1 14,4 C14,7 2,7 2,4 M2,4 L2,12 C2,15 14,15 14,12 L14,4 M2,8 C2,11 14,11 14,8"/>
                        <TextBlock Text="LOCAL TOKEN STORAGE" Margin="9,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#ABB0C9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="GUILDSYNC   •   ALPHA"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Margin="0,0,0,35" Foreground="#646984" FontSize="11" FontWeight="SemiBold"/>
        </Grid>

        <!-- Login side -->
        <Grid Grid.Column="1" Background="{StaticResource LoginBackground}" ClipToBounds="True">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-210,-250,0" Fill="#122C22A4" IsHitTestVisible="False">
                <Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="360" Height="360" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-180,0,0,-190" Fill="#161D2A66" IsHitTestVisible="False">
                <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
            </Ellipse>

            <Grid Width="500" Height="632" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,26,28,26">
                <Border x:Name="GhostCardBack" Width="438" Height="570" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#101426" BorderBrush="#3F4672" BorderThickness="1" CornerRadius="22" Opacity="0">
                    <Border.RenderTransform><TranslateTransform x:Name="GhostCardBackTranslate" X="190"/></Border.RenderTransform>
                </Border>
                <Border x:Name="GhostCardMiddle" Width="454" Height="590" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#12172A" BorderBrush="#53517E" BorderThickness="1" CornerRadius="22" Opacity="0">
                    <Border.RenderTransform><TranslateTransform x:Name="GhostCardMiddleTranslate" X="170"/></Border.RenderTransform>
                </Border>

                <Grid x:Name="MotionLine" Width="190" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <Grid.RenderTransform><TranslateTransform x:Name="MotionLineTranslate" X="230"/></Grid.RenderTransform>
                    <Path Stroke="#6B5BFF" StrokeThickness="2" Data="M190,15 L22,15 M22,15 L38,3 M22,15 L38,27">
                        <Path.Effect><BlurEffect Radius="4"/></Path.Effect>
                    </Path>
                    <Path Stroke="#8B70FF" StrokeThickness="1.5" Data="M190,15 L22,15 M22,15 L38,3 M22,15 L38,27"/>
                </Grid>

                <Border x:Name="LoginCard" Width="470" Height="612" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource CardBackground}" BorderBrush="#4A4F75" BorderThickness="1"
                        CornerRadius="22" Padding="40,36,40,30" Opacity="0"
                        RenderTransformOrigin="1,0.5">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="10" Opacity="0.55"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LoginCardScale" ScaleX="0.72" ScaleY="1"/>
                            <TranslateTransform x:Name="LoginCardTranslate" X="180"/>
                        </TransformGroup>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" Background="#242942" BorderBrush="#30365B" BorderThickness="1">
                                <ContentControl x:Name="CardMarkHost" Width="30" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,1,0,0">
                                <TextBlock Text="Welcome back" FontSize="31" FontWeight="Bold" Foreground="#F7F8FF"/>
                                <TextBlock Text="Sign in to your GuildSync account" Foreground="#9DA2BA" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,33,0,0">
                            <TextBlock Text="Email" Foreground="#EEF0FF" FontSize="13" Margin="0,0,0,8"/>
                            <Border Height="56" Background="#0B0F1D" BorderBrush="#424963" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="19" Height="15" Stretch="Uniform" Stroke="#858BA7" StrokeThickness="1.6" Fill="Transparent"
                                          Data="M1,3 L9.5,9 L18,3 M2,2 L17,2 C18,2 19,3 19,4 L19,14 C19,15 18,16 17,16 L2,16 C1,16 0,15 0,14 L0,4 C0,3 1,2 2,2"/>
                                    <TextBox x:Name="EmailBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Padding="0,17,14,0" FontSize="14" Foreground="#F6F7FF" CaretBrush="White"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Password" Foreground="#EEF0FF" FontSize="13" Margin="0,22,0,8"/>
                            <Border Height="56" Background="#0B0F1D" BorderBrush="#424963" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17" Height="20" Stretch="Uniform" Stroke="#858BA7" StrokeThickness="1.6" Fill="Transparent"
                                          Data="M4,8 L4,5 C4,1 12,1 12,5 L12,8 M2,8 L14,8 C15,8 16,9 16,10 L16,18 C16,19 15,20 14,20 L2,20 C1,20 0,19 0,18 L0,10 C0,9 1,8 2,8 M8,12 L8,16"/>
                                    <PasswordBox x:Name="PasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                 Padding="0,17,8,0" FontSize="14" Foreground="#F6F7FF" CaretBrush="White"/>
                                    <Path Grid.Column="2" Width="21" Height="14" Stretch="Uniform" Stroke="#858BA7" StrokeThickness="1.5" Fill="Transparent"
                                          Data="M1,7 C5,0 16,0 20,7 C16,14 5,14 1,7 M7,7 A3,3 0 1 0 13,7 A3,3 0 1 0 7,7"/>
                                </Grid>
                            </Border>

                            <Button x:Name="LoginButton" Style="{StaticResource LoginPrimaryButton}" Content="Sign in"
                                    Margin="0,27,0,0" Click="LoginButton_Click"/>
                            <Button Style="{StaticResource LoginSecondaryButton}" Margin="0,12,0,0" Click="RegisterButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" FontSize="19" Margin="0,-1,7,0"/>
                                    <TextBlock Text="Create account" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="StatusText" Foreground="#BEC2D4" TextWrapping="Wrap" FontSize="12" Margin="0,14,0,0"/>

                            <Border x:Name="PendingBox" Visibility="Collapsed" Background="#211936" BorderBrush="#6D28D9"
                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="License required" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Status: Pending" Foreground="#C4B5FD" Margin="0,4,0,0"/>
                                    <TextBlock Text="Sign in to choose a plan, or connect your account with the official GuildSync bot."
                                               Foreground="#A8AABC" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,19,0,0">
                            <Grid Margin="0,0,0,15">
                                <Border Height="1" Background="#2B3046" VerticalAlignment="Center"/>
                                <Border Width="40" Height="24" Background="#14182A" HorizontalAlignment="Center">
                                    <Path Width="17" Height="19" Stretch="Uniform" Stroke="#505875" StrokeThickness="1.5" Fill="Transparent"
                                          Data="M9,1 L16,4 L16,10 C16,15 13,18 9,20 C5,18 2,15 2,10 L2,4 Z M6,10 L8,12 L12,7"/>
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#58E6B0" Margin="0,0,10,0">
                                    <Ellipse.Effect><DropShadowEffect Color="#58E6B0" BlurRadius="8" ShadowDepth="0"/></Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="BackendModeText" Foreground="#8F95AD" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
