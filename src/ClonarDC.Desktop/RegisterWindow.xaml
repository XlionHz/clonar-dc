<Window x:Class="ClonarDC.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create account — GuildSync"
        Width="560" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#0B0E1A">
        <Ellipse Width="330" Height="330" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-170,-160,0" Fill="#162C24A6" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
        </Ellipse>
        <Border Margin="34" Padding="34" Background="#15192A" BorderBrush="#3D4262" BorderThickness="1" CornerRadius="20">
            <Grid>
                <StackPanel x:Name="FormPanel">
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ContentControl x:Name="RegisterBrandHost" Width="66" Height="74" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,5,0,0">
                            <TextBlock Text="Create GuildSync account" FontSize="27" FontWeight="Bold"/>
                            <TextBlock Text="Protected access for backup, cloning and restore workflows." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Name" Margin="0,0,0,6"/><TextBox x:Name="NameBox" Height="44"/>
                    <TextBlock Text="Email" Margin="0,14,0,6"/><TextBox x:Name="EmailBox" Height="44"/>
                    <TextBlock Text="Password" Margin="0,14,0,6"/><PasswordBox x:Name="PasswordBox" Height="44"/>
                    <TextBlock Text="Repeat password" Margin="0,14,0,6"/><PasswordBox x:Name="ConfirmBox" Height="44"/>
                    <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Content="Create account" Height="46" Margin="0,23,0,0" Click="CreateButton_Click" IsDefault="True"/>
                    <ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,12,0,0"/>
                    <Border x:Name="FeedbackBox" Visibility="Collapsed" Background="#24151D" BorderBrush="#FB7185" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Foreground="#FDA4AF" TextWrapping="Wrap"/></Border>
                </StackPanel>

                <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <ContentControl x:Name="RegisterSuccessBrandHost" Width="112" Height="126" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SuccessTitleText" Text="GuildSync account created!" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock x:Name="SuccessBodyText" Text="Your account was created successfully. Sign in to choose a license or connect the official GuildSync bot to Discord." Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="18,12,18,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
