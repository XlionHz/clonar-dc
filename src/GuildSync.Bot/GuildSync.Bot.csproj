<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GuildSync.Bot</AssemblyName>
    <RootNamespace>GuildSync.Bot</RootNamespace>
    <Product>GuildSync Bot</Product>
    <Title>GuildSync Bot</Title>
    <Company>GuildSync</Company>
    <Authors>GuildSync</Authors>
    <Description>Official slash-command bot for GuildSync account linking, licenses and checkout.</Description>
    <Version>0.8.3.3</Version>
    <FileVersion>0.8.3.3</FileVersion>
    <AssemblyVersion>0.8.3.3</AssemblyVersion>
    <InformationalVersion>0.8.3.3-provider-separation</InformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.18.0" />
  </ItemGroup>
</Project>